NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
SANITY_API_TOKEN=your_editor_token
SANITY_REVALIDATE_SECRET=replace_with_a_long_random_secret

# Resend: create an API key at resend.com and verify your sending domain.
# FROM_EMAIL must use a verified custom domain (not Gmail).
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=hello@arizonix.com
RESEND_TO_EMAIL=team@arizonix.com

# Upstash: create a Redis database at upstash.com and copy its REST credentials.
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxx

# Spam protection
CONTACT_FORM_HONEYPOT_FIELD=website_url

# Analytics and monitoring
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
