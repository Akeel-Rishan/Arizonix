{
  "name": "arizonix",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "analyze": "set ANALYZE=true&& npm run build",
    "lighthouse:ci": "lhci autorun",
    "lighthouse:local": "lhci autorun --collect.url=http://localhost:3000",
    "a11y:axe": "axe http://localhost:3000 http://localhost:3000/about http://localhost:3000/services http://localhost:3000/ai-automation http://localhost:3000/blog http://localhost:3000/contact --exit --chrome-options=\"no-sandbox,disable-setuid-sandbox,disable-dev-shm-usage\" --load-delay 1500",
    "html:validate": "html-validate .next/server/app/**/*.html",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@portabletext/react": "^6.2.0",
    "@sanity/image-url": "^2.1.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.468.0",
    "next": "^15.5.24",
    "next-sanity": "^11.6.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "resend": "^6.16.0",
    "sanity": "^4.22.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.12.1",
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "^15.5.24",
    "@next/swc-win32-x64-msvc": "^15.5.24",
    "@sanity/vision": "^4.22.1",
    "@sentry/nextjs": "^8.55.2",
    "@types/node": "^20.17.14",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.6.1",
    "chromedriver": "^153.0.2",
    "critters": "^0.0.23",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.24",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "html-validate": "^11.5.6",
    "postcss": "^8.5.28",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "wait-on": "^9.0.10",
    "web-vitals": "^5.3.0"
  },
  "overrides": {
    "semver": "7.7.2",
    "postcss": "$postcss",
    "@sanity/runtime-cli": {
      "adm-zip": "0.6.1"
    }
  }
